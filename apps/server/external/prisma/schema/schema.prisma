generator client {
  provider = "prisma-client"
  output   = "../generated"
  moduleFormat = "esm"
  binaryTargets = ["native", "windows", "darwin-arm64", "rhel-openssl-3.0.x"]
}

generator prismabox {
  provider = "prismabox"
  typeboxImportDependencyName = "elysia"
  typeboxImportVariableName = "t"
  inputModel = true
  output   = "../generated/prismabox"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}
